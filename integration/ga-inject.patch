diff --git a/tests/ga-verimots.test.mjs b/tests/ga-verimots.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/ga-verimots.test.mjs
@@ -0,0 +1,90 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import vm from 'node:vm'
+import { readFileSync } from 'node:fs'
+
+process.env.PFA87_GA_ID = 'G-TESTID1234'
+process.env.PFA87_GA_CONSENT = 'granted'
+const { injectGa, gaSnippet } = await import('../scripts/ga-inject.mjs')
+
+function runTag(hostname, values = {}, blocked = false) {
+  const scripts = []
+  const context = {
+    location: { hostname },
+    localStorage: { getItem: key => { if (blocked) throw new Error('denied'); return values[key] ?? null } },
+    document: { createElement: () => ({}), head: { appendChild: script => scripts.push(script) } },
+  }
+  context.window = context
+  vm.runInNewContext(gaSnippet().match(/<script>([\s\S]*?)<\/script>/)[1], context)
+  return { entries: context.dataLayer.map(args => Array.from(args)), scripts }
+}
+
+test('explicit page opt-out prevents every shared GA byte, with either attribute order', () => {
+  for (const meta of [
+    '<meta name="pfa87-analytics" content="off">',
+    "<META content='OFF' NAME='pfa87-analytics' />",
+    '<meta data-note="a > b" content = "off" name = "pfa87-analytics">',
+    '<meta name=pfa87-analytics content=off>',
+  ]) {
+    const html = `<html><head>${meta}</head><body>Sign in</body></html>`
+    assert.equal(injectGa(html, 's.pfa87.cc'), html)
+    assert.equal(injectGa(html, 'verimots.pfa87.cc'), html)
+    assert.equal(injectGa(html), html, 'serve callers without hostname also honor page opt-out')
+  }
+})
+
+test('unrelated metadata and inert examples do not disable analytics', () => {
+  for (const meta of [
+    '<meta name="pfa87-analytics" content="on">',
+    '<meta name="other" content="off">',
+    '<!-- <meta name="pfa87-analytics" content="off"> -->',
+    '<script>const example = \'<meta name="pfa87-analytics" content="off">\'</script>',
+    '<meta name="other" title="name=pfa87-analytics content=off">',
+  ]) {
+    assert.match(injectGa(`<html><head>${meta}</head></html>`, 'menu.pfa87.cc'), /<!--pfa87-ga-->/)
+  }
+})
+
+test('Verimots defaults denied before config even when the global default is granted', () => {
+  for (const hostname of ['s.pfa87.cc', 'verimots.pfa87.cc', 'S.PFA87.CC', 'news.pfa87.cc']) {
+    for (const blocked of [false, true]) {
+      const { entries } = runTag(hostname, {}, blocked)
+      const consent = entries.find(([cmd, action]) => cmd === 'consent' && action === 'default')
+      assert.equal(consent[2].analytics_storage, 'denied', hostname)
+      assert.equal(consent[2].ad_storage, 'denied')
+      assert.ok(entries.indexOf(consent) < entries.findIndex(([cmd]) => cmd === 'config'))
+    }
+  }
+})
+
+test('stored shared and legacy choices still override the denied default', () => {
+  for (const hostname of ['s.pfa87.cc', 'verimots.pfa87.cc']) {
+    for (const key of ['pfa87-consent', 'verimots-consent']) {
+      for (const choice of ['granted', 'denied']) {
+        const { entries } = runTag(hostname, { [key]: choice })
+        const consent = entries.filter(([cmd]) => cmd === 'consent')
+        assert.equal(consent[0][2].analytics_storage, 'denied')
+        assert.equal(consent.at(-1)[2].analytics_storage, choice)
+        assert.ok(entries.indexOf(consent.at(-1)) < entries.findIndex(([cmd]) => cmd === 'config'))
+      }
+    }
+  }
+})
+
+test('unrelated hosts retain the configured default and stored refusal', () => {
+  for (const hostname of ['menu.pfa87.cc', 'family.pfa87.cc', 's.pfa87.cc.example.org', 'verimots-test.pfa87.cc']) {
+    let consent = runTag(hostname).entries.filter(([cmd]) => cmd === 'consent')
+    assert.equal(consent[0][2].analytics_storage, 'granted')
+    consent = runTag(hostname, { 'pfa87-consent': 'denied' }).entries.filter(([cmd]) => cmd === 'consent')
+    assert.equal(consent.at(-1)[2].analytics_storage, 'denied')
+  }
+})
+
+test('both actual Android handoff pages suppress the injector before token handling', { skip: !process.env.VERIMOTS_REVIEW_ROOT }, () => {
+  const root = process.env.VERIMOTS_REVIEW_ROOT
+  for (const name of ['auth-android.html', 'auth-android-done.html']) {
+    const html = readFileSync(`${root}/web/${name}`, 'utf8')
+    assert.match(html, /name="pfa87-analytics" content="off"/)
+    assert.equal(injectGa(html, 's.pfa87.cc'), html)
+  }
+})
