 export function gaTagsHost(host) {
   const h = String(host || '').toLowerCase().split(':')[0]
   return Boolean(h) && !OWN_PROPERTY_HOSTS.has(h)
+}
+
+// Sensitive handoff pages can opt out before the shared tag is injected.
+// Ignore examples in comments/scripts, and accept normal HTML attribute order.
+function pageOptsOut(html) {
+  const markup = html.replace(/<!--[\s\S]*?-->|<script\b[^>]*>[\s\S]*?<\/script\s*>/gi, '')
+  for (const tag of markup.match(/<meta\b(?:[^"'<>]|"[^"]*"|'[^']*')*>/gi) || []) {
+    const attrs = new Map()
+    for (const match of tag.matchAll(/\s([a-z][a-z0-9:-]*)\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'=<>`]+))/gi)) {
+      const name = match[1].toLowerCase()
+      if (!attrs.has(name)) attrs.set(name, (match[2] ?? match[3] ?? match[4]).trim().toLowerCase())
+    }
+    if (attrs.get('name') === 'pfa87-analytics' && attrs.get('content') === 'off') return true
+  }
+  return false
 }
 
