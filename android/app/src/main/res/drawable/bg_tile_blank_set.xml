<?xml version="1.0" encoding="utf-8"?>
<!-- A joker standing for a letter: the rim goes solid gold. The letter is on
     loan and the tile is still worth 0. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#8a7340" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#f4e6c0"
                android:startColor="#fffdf4" />
            <corners android:radius="8dp" />
            <stroke
                android:width="2dp"
                android:color="@color/gold" />
        </shape>
    </item>
</layer-list>
