<?xml version="1.0" encoding="utf-8"?>
<!-- The web .game-input: a dark inset well with a gold rim inside the game card. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0f1713" />
            <stroke android:width="2dp" android:color="@color/gold" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f1713" />
            <stroke android:width="2dp" android:color="@color/rim_gold" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
