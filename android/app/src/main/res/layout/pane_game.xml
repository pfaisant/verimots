<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/game_cat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="@string/challenge"
            android:textAllCaps="true"
            android:textColor="@color/gold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/game_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/competition"
            android:textColor="@color/gold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/game_kids"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/mode_kids"
            android:textColor="@color/gold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/game_avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_count"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/avg_empty"
            android:textColor="@color/dim"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/game_rack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:minHeight="64dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/game_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/game_q"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:fontFamily="sans-serif-medium"
            android:hint="@string/play_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:letterSpacing="0.1"
            android:maxLength="7"
            android:paddingHorizontal="16dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/dim"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/game_go"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gold_btn"
            android:contentDescription="@string/validate"
            android:padding="14dp"
            android:src="@drawable/ic_check" />
    </LinearLayout>

    <TextView
        android:id="@+id/game_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:paddingVertical="4dp"
        android:text="@string/kids_hint"
        android:textColor="@color/gold"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/game_live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:minHeight="18dp"
        android:textColor="@color/dim"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/game_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingEnd="72dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/game_pct"
                    style="@style/Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/game_break"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:textColor="@color/ink"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/game_vs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <cc.pfa87.ods9.FlowLayout
                android:id="@+id/game_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/game_again"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/encore"
                android:textColor="@color/gold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/game_pos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/gold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/game_def"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/game_lemma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/game_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/game_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/game_wa"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_wa"
            android:contentDescription="@string/share"
            android:padding="10dp"
            android:src="@drawable/ic_wa"
            android:visibility="invisible" />

        <cc.pfa87.ods9.ScoreChartView
            android:id="@+id/game_chart"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:minWidth="44dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/game_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/game_last_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="/100"
                android:textColor="@color/dim"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
