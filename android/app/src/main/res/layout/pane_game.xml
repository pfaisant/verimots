<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/game_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <TextView
        android:id="@+id/game_hub_back"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_pill"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/menu_back"
        android:textColor="@color/gold"
        android:textSize="13sp"
            android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/menu_title"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/menu_comp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:drawableStart="@drawable/ic_tab_board"
                    android:drawablePadding="12dp"
                    android:text="@string/menu_comp"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/menu_comp_blurb"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_find"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:drawableStart="@drawable/ic_tab_check"
                    android:drawablePadding="12dp"
                    android:text="@string/menu_find"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/menu_find_blurb"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_training"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:drawableStart="@drawable/ic_combinations"
                    android:drawablePadding="12dp"
                    android:text="@string/menu_training"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/training_blurb"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_study"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:drawableStart="@drawable/ic_book"
                    android:drawablePadding="12dp"
                    android:text="@string/menu_study"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/menu_study_blurb"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
        android:id="@+id/level_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="@string/level_title"
            android:textAllCaps="true"
            android:textColor="@color/dim"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_seg_track"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/level_beginner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="110dp"
                android:minWidth="96dp"
                android:paddingHorizontal="14dp"
                android:text="@string/level_beginner"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/level_confirmed"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="110dp"
                android:minWidth="96dp"
                android:paddingHorizontal="14dp"
                android:text="@string/level_confirmed"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Compact segmented level pill: dark inset track, gold gradient on the
         selected segment, small uppercase label to the left, no card. -->

    </LinearLayout>

    <LinearLayout
        android:id="@+id/game_play"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

    <ScrollView
        android:id="@+id/game_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="true"
        android:overScrollMode="never"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <!-- Game context and quiet divider; the
             kicker shrinks first so Retour is never pushed off-screen. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/game_cat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0"
                android:maxLines="1"
                android:text="@string/challenge"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@color/line" />
        </LinearLayout>

        <TextView
            android:id="@+id/game_mode"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/game_training"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/game_kids"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/game_avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_count"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/dim"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/game_menu_back"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/menu_back"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:visibility="gone" />


    </LinearLayout>

        <TextView
            android:id="@+id/game_auth_warn"
            android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_warn"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/not_connected_tap"
            android:textColor="@color/orange"
            android:textSize="13sp"
            android:visibility="gone" />

    <LinearLayout
        android:id="@+id/training_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_panel14"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <!-- "Mode de jeu" label · preset dropdown · min chip · i · progress (far right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:visibility="gone"
                android:text="@string/training_mode_label"
                android:textAllCaps="true"
                android:textColor="@color/dim"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/training_preset_btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:textColor="@color/gold"
                android:textSize="12sp"
            android:layout_weight="1" />

            <TextView
                android:id="@+id/training_min_btn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_quiet"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minWidth="48dp"
                android:paddingHorizontal="8dp"
                android:textColor="@color/dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/training_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/gold"
                android:textSize="12sp"
            android:maxWidth="64dp" />
        </LinearLayout>

    </LinearLayout>



    <LinearLayout
        android:id="@+id/game_rack_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/game_alpha"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_count"
            android:clickable="true"
            android:contentDescription="@string/rack_alpha"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:text="@string/rack_alpha"
            android:textColor="@color/dim"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/game_rack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="horizontal" />


    </LinearLayout>

    <TextView
        android:id="@+id/joker_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/joker_rack_note"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/game_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp">

            <EditText
                android:id="@+id/game_q"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_input"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="@string/play_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:letterSpacing="0.08"
                android:maxLength="8"
                android:paddingStart="14dp"
                android:paddingEnd="48dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/dim"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/game_clear"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_icon_action"
                android:contentDescription="@string/clear"
                android:visibility="gone"
            style="@style/IconAction"
            android:src="@drawable/ic_clear"
            android:padding="12dp" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/game_go"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gold_btn"
            android:contentDescription="@string/validate"
            android:padding="12dp"
            android:src="@drawable/ic_check" />
    </LinearLayout>



    <!-- Validation feedback collapses when empty. -->
    <LinearLayout
        android:id="@+id/game_live_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/game_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/dim"
            android:textSize="13.5sp" />
    </LinearLayout>



    <!-- Combinaisons: words found this round, newest first, tappable -->
    <cc.pfa87.ods9.FlowLayout
        android:id="@+id/training_found_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:visibility="gone" />

    <!-- Combinaisons: definition of a tapped found/revealed chip -->
    <LinearLayout
        android:id="@+id/training_def_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/training_def_pos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/training_def_fav"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_action"
                android:contentDescription="@string/fav_add"
            style="@style/IconAction"
            android:src="@drawable/ic_star"
            android:padding="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/training_def_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/DefinitionText" />
                <TextView android:id="@+id/training_def_more" style="@style/DefinitionMore" android:text="@string/definition_more" />

        <TextView
            android:id="@+id/training_def_lemma" style="@style/DefinitionLink"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/training_def_wiki"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/wiki"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/game_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/game_pct"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/game_break"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="15sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0"
                        android:maxLines="1"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/game_vs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/game_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/game_def_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/game_pos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0"
                        android:maxLines="2"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/game_fav"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_action"
                        android:contentDescription="@string/fav_add"
            style="@style/IconAction"
            android:src="@drawable/ic_star"
            android:padding="12dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/game_def"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
            style="@style/DefinitionText" />
                <TextView android:id="@+id/game_def_more" style="@style/DefinitionMore" android:text="@string/definition_more" />

                <TextView
                    android:id="@+id/game_lemma" style="@style/DefinitionLink"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/game_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp" />



        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/game_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:minWidth="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/game_chart_avg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/game_chart_avg_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/chart_avg"
                android:textColor="@color/dim"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <cc.pfa87.ods9.ScoreChartView
            android:id="@+id/game_chart"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:baselineAligned="true"
            android:minWidth="44dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/game_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/game_last_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="/100"
                android:textColor="@color/dim"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/game_options"
            style="@style/IconAction"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/options_title" />

    </LinearLayout>

    <Button
        android:id="@+id/game_again"
        style="@style/PrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/next_rack"
        android:text="@string/next_rack"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/game_study"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/study_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/study_back" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:text="@string/menu_study" android:textColor="@color/ink"
                    android:textSize="22sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/game_study_when" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/study_blurb" android:textColor="@color/muted"
                    android:textSize="13sp" android:lineSpacingMultiplier="1.12" />
                <TextView android:id="@+id/game_study_twos_label" style="@style/SectionLabel"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                    android:text="@string/study_twos" />
                <cc.pfa87.ods9.FlowLayout android:id="@+id/game_study_twos_words"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/game_study_threes_label" style="@style/SectionLabel"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/study_threes" />
                <cc.pfa87.ods9.FlowLayout android:id="@+id/game_study_threes_words"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />

                <LinearLayout android:id="@+id/study_def_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical"
                    android:padding="12dp" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:id="@+id/study_def_head" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:maxLines="2" android:ellipsize="end"
                            android:textColor="@color/muted" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                        <ImageButton android:id="@+id/study_fav" style="@style/IconAction"
                            android:contentDescription="@string/fav_add" android:src="@drawable/ic_star" />
                    </LinearLayout>
                    <TextView android:id="@+id/study_def_body" style="@style/DefinitionText"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                    <TextView android:id="@+id/study_def_more" style="@style/DefinitionMore" android:text="@string/definition_more" />
                    <TextView android:id="@+id/study_def_lemma" style="@style/DefinitionLink" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/game_study_body" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/study_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="16dp" android:paddingTop="8dp" android:paddingBottom="6dp" android:gravity="center_vertical">
            <TextView android:id="@+id/study_challenge" style="@style/PrimaryAction"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="@string/study_challenge" android:drawableStart="@drawable/ic_tab_game" android:drawableTint="@color/tile_ink"
                android:drawablePadding="8dp" />
            <ImageButton android:id="@+id/game_study_share" style="@style/IconAction"
                android:layout_marginStart="8dp" android:contentDescription="@string/study_share" android:src="@drawable/ic_share" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
