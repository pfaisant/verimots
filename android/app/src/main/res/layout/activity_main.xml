<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/felt_dark"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <FrameLayout
        android:id="@+id/header_chrome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/header_identity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingEnd="0dp"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/header_back"
                style="@style/IconAction"
                android:visibility="gone"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/menu_back" />
            <ImageView
                android:id="@+id/mark"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />
            <TextView
                android:id="@+id/brand_title"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/live"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pane_check"
            layout="@layout/pane_check" />

        <include
            android:id="@+id/pane_game"
            layout="@layout/pane_game"
            android:visibility="gone" />

        <include
            android:id="@+id/pane_about"
            layout="@layout/pane_about"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/feedback_fab"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="@string/feedback" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_dock"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tab_check"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_tab_check"
            android:text="@string/tab_check" />

        <TextView
            android:id="@+id/tab_game"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_tab_game"
            android:text="@string/tab_game" />

        <TextView
            android:id="@+id/tab_board"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_tab_board"
            android:text="@string/tab_board" />

        <TextView
            android:id="@+id/tab_about"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_tab_about"
            android:text="@string/tab_about" />
    </LinearLayout>
</LinearLayout>
