<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/felt_dark"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/mark"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/brand_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/brand_sub"
                android:textColor="@color/dim"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_count"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/loading"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pane_check"
            layout="@layout/pane_check" />

        <include
            android:id="@+id/pane_game"
            layout="@layout/pane_game"
            android:visibility="gone" />

        <include
            android:id="@+id/pane_about"
            layout="@layout/pane_about"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_dock"
        android:padding="5dp">

        <TextView
            android:id="@+id/tab_check"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_tab_check"
            android:text="@string/tab_check" />

        <TextView
            android:id="@+id/tab_game"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_tab_game"
            android:text="@string/tab_game" />

        <TextView
            android:id="@+id/tab_about"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_tab_about"
            android:text="@string/tab_about" />
    </LinearLayout>
</LinearLayout>
