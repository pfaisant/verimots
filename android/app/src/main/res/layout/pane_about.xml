<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp">

        <!-- Language and dictionary live in Options, outside the game header. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/lang_switch"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/language_choice"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="120dp"
                    android:maxWidth="180dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical|end"
                    android:paddingHorizontal="8dp"
                    android:drawableEnd="@drawable/ic_chevron_down"
                    android:drawablePadding="8dp"
                    android:text="@string/lang_fr"
                    android:textColor="@color/gold"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_dicts"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/brand_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="120dp"
                    android:maxWidth="180dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical|end"
                    android:paddingHorizontal="8dp"
                    android:drawableEnd="@drawable/ic_chevron_down"
                    android:drawablePadding="8dp"
                    android:text="@string/dict_using_ods"
                    android:textColor="@color/gold"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Compte Google (web .game-auth / .user-card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/auth_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/google_account"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/auth_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/sign_in_hint"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/auth_google"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_gold_btn"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/sign_in_google"
                android:textColor="@color/tile_ink"
            android:textSize="14sp" />

            <!-- Signed in: avatar (gold ring) · name · i · Se déconnecter -->
            <LinearLayout
                android:id="@+id/auth_user_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel14"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <TextView
                        android:id="@+id/auth_pic_fallback"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_fallback"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/tile_ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/auth_pic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_ring"
                        android:contentDescription="@null"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/auth_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <!-- Round "i": opens the "Mes statistiques" dialog -->
                <ImageButton
                    android:id="@+id/auth_stats"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_action"
                    android:clickable="true"
                    android:contentDescription="@string/user_stats_title"
                    android:focusable="true"
            style="@style/IconAction"
            android:src="@drawable/ic_tab_about"
            android:padding="12dp" />

                <ImageButton
                    android:id="@+id/auth_logout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_action"
                    android:ellipsize="end"
                    android:maxLines="1"
            style="@style/IconAction"
            android:src="@drawable/ic_logout"
            android:padding="12dp"
            android:contentDescription="@string/sign_out" />
            </LinearLayout>
        </LinearLayout>

        <!-- Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:text="@string/options_title"
                    android:textAllCaps="true"
                    android:textColor="@color/gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hairline_gold" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_opt_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/opt_alpha_btn"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/opt_alpha_help"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/alpha_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_opt_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/advanced_mode"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/advanced_help"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/advanced_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:checked="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dictionnaire -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:text="@string/settings_dicts"
                    android:textAllCaps="true"
                    android:textColor="@color/gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hairline_gold" />
            </LinearLayout>



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/settings_dicts_help"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <!-- Additional tile options for the chosen dictionary. -->
            <LinearLayout
                android:id="@+id/dict_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <!-- Catalan tiles: NY, QU and L·L are single tiles, shown with DISC -->
                <LinearLayout
                    android:id="@+id/ca_tiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.3"
                        android:text="@string/ca_tiles_help"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Spanish tile set (FISE 100 / North America 103), shown with RLA-ES -->
                <LinearLayout
                    android:id="@+id/es_edition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/es_edition_label"
                        android:textAllCaps="true"
                        android:textColor="@color/dim"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/es_edition_fise"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dict_on"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="10dp"
                            android:text="@string/es_edition_fise"
                            android:textColor="@color/ink"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/es_edition_na"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_dict_off"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="10dp"
                            android:text="@string/es_edition_na"
                            android:textColor="@color/ink"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="@string/es_edition_help"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- À propos (web .info) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <!-- Title + word-count pill top-right (web .info-head / .info-lex) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/about_title"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/about_lex"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:visibility="gone"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_lex_pill"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="150dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/loading"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_body"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <!-- Historique · Favoris · Avis (web .info-actions) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hist_open"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_icon_action"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="4dp"
                    android:text="@string/hist_open"
                    android:textColor="@color/gold"
                    android:textSize="12sp"
            android:drawableTop="@drawable/ic_history"
            android:drawablePadding="6dp"
            android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/fav_open"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_icon_action"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="4dp"
                    android:text="@string/fav_open"
                    android:textColor="@color/gold"
                    android:textSize="12sp"
            android:drawableTop="@drawable/ic_star"
            android:drawablePadding="6dp"
            android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/about_feedback"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_icon_action"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="4dp"
                    android:text="@string/feedback"
                    android:textColor="@color/gold"
                    android:textSize="12sp"
            android:drawableTop="@drawable/ic_feedback"
            android:paddingVertical="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/about_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Confidentialité -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/privacy_title"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/privacy_body"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/privacy_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/privacy_link"
                android:textColor="@color/gold"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
