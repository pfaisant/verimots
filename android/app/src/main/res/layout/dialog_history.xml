<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/hist_dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="2"
                android:text="@string/hist_local"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hist_dialog_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/hist_dialog_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_count"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/ink"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Leaderboard only: "Semaine | Général" segmented pill (web .board-tabs) -->
    <LinearLayout
        android:id="@+id/hist_dialog_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_seg_track"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/board_scope_week"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:minWidth="64dp"
                android:paddingHorizontal="10dp"
                android:text="@string/board_week"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/board_scope_all"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:minWidth="64dp"
                android:paddingHorizontal="10dp"
                android:text="@string/board_general"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:paddingHorizontal="12dp"
        android:scrollbarSize="6dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/hist_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </ScrollView>

    <TextView
        android:id="@+id/hist_clear"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/hist_clear"
        android:textColor="@color/gold" />
</LinearLayout>
