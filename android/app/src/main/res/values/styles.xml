<resources>
    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:background">@drawable/bg_nav</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:breakStrategy">simple</item>
    </style>
    <style name="Display">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
