    <string name="dict_blurb_fr">Community list for French tournament play. Not L’Officiel du Scrabble (Larousse / FISF).</string>
    <string name="dict_blurb_en">Public-domain YAWL list, close to international play. Not Collins / HarperCollins CSW.</string>
    <string name="dict_blurb_wow24">List published by the WGPO (Official Words 2024). Distinct from NASPA’s NWL.</string>
    <string name="dict_blurb_es">Free RLA-ES list (MPL 1.1). Not the official FILE / RAE Lexicón.</string>
